# Environment Configuration Template
# Rename this file to .env and update with your credentials

# Database Configuration
DB_USER=system
DB_PASSWORD=your_oracle_password
DB_CONNECTION_STRING=localhost/XE
DB_POOL_MIN=2
DB_POOL_MAX=10

# Server Configuration
PORT=3000
NODE_ENV=development

# Session Configuration
SESSION_SECRET=erp-secret-key-2024
SESSION_TIMEOUT=86400000

# Application Configuration
APP_NAME=University ERP System
APP_URL=http://localhost:3000

# Email Configuration (for future use)
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password

# Features Toggle
ENABLE_EMAIL_NOTIFICATIONS=false
ENABLE_FILE_UPLOADS=false
ENABLE_GRADE_NOTIFICATIONS=false

# Logging
LOG_LEVEL=debug
LOG_FILE=./logs/erp.log
