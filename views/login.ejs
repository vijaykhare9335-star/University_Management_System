<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - University ERP</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>
<body class="auth-page">
    <div class="auth-container">
        <div class="auth-box login-box">
            <div class="auth-header">
                <i class="fas fa-graduation-cap"></i>
                <h1>University ERP</h1>
                <p>Login to your account</p>
            </div>

            <form id="loginForm" class="auth-form">
                <div class="form-group">
                    <label for="email">Email Address</label>
                    <div class="input-group">
                        <i class="fas fa-envelope"></i>
                        <input type="email" id="email" name="email" placeholder="Enter your email" required>
                    </div>
                </div>

                <div class="form-group">
                    <label for="password">Password</label>
                    <div class="input-group">
                        <i class="fas fa-lock"></i>
                        <input type="password" id="password" name="password" placeholder="Enter your password" required>
                    </div>
                    <small style="color: #0d6efd; cursor: pointer;">Forgot Password?</small>
                </div>

                <div class="form-group">
                    <label for="role">Login as</label>
                    <div class="role-selector">
                        <label class="role-option">
                            <input type="radio" name="role" value="Student" checked>
                            <span class="role-icon"><i class="fas fa-book"></i></span>
                            <span class="role-label">Student</span>
                        </label>
                        <label class="role-option">
                            <input type="radio" name="role" value="Instructor">
                            <span class="role-icon"><i class="fas fa-chalkboard-user"></i></span>
                            <span class="role-label">Instructor</span>
                        </label>
                    </div>
                </div>

                <button type="submit" class="btn btn-primary btn-full">Login</button>
            </form>

            <div class="auth-divider">
                <span>OR</span>
            </div>

            <p class="auth-footer">
                Don't have an account? <a href="/register">Register here</a>
            </p>

            <div class="demo-credentials">
                <p><strong>Demo Credentials:</strong></p>
                <p><small>Student: arun@student.edu / password123</small></p>
                <p><small>Instructor: rajesh@university.edu / password123</small></p>
            </div>
        </div>

        <div class="auth-illustrations">
            <div class="illustration-card">
                <i class="fas fa-chart-line"></i>
                <h3>Track Your Progress</h3>
                <p>Monitor your academic performance and grades</p>
            </div>
            <div class="illustration-card">
                <i class="fas fa-book-open"></i>
                <h3>Access Courses</h3>
                <p>Browse and enroll in courses from across departments</p>
            </div>
            <div class="illustration-card">
                <i class="fas fa-users"></i>
                <h3>Connect</h3>
                <p>Get in touch with faculty and classmates</p>
            </div>
        </div>
    </div>

    <script src="/js/auth.js"></script>
</body>
</html>
