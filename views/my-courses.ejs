<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Courses - University ERP</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>
<body class="dashboard-page">
    <!-- Sidebar -->
    <aside class="sidebar">
        <div class="sidebar-header">
            <i class="fas fa-graduation-cap"></i>
            <span>Student Portal</span>
        </div>

        <nav class="sidebar-menu">
            <a href="/student-dashboard" class="menu-item">
                <i class="fas fa-home"></i>
                <span>Home</span>
            </a>
            <a href="/my-courses" class="menu-item active">
                <i class="fas fa-book"></i>
                <span>My Courses</span>
            </a>
            <a href="/enrollments" class="menu-item">
                <i class="fas fa-edit"></i>
                <span>Enrollments</span>
            </a>
            <a href="#" class="menu-item">
                <i class="fas fa-calendar"></i>
                <span>Timetable</span>
            </a>
            <a href="/grades" class="menu-item">
                <i class="fas fa-chart-bar"></i>
                <span>Grades</span>
            </a>
            <a href="/faculty" class="menu-item">
                <i class="fas fa-chalkboard-user"></i>
                <span>Faculty Contacts</span>
            </a>
            <a href="/announcements" class="menu-item">
                <i class="fas fa-bell"></i>
                <span>Announcements</span>
            </a>
            <a href="#" class="menu-item">
                <i class="fas fa-book-open"></i>
                <span>Technical Resources</span>
            </a>
            <a href="/profile" class="menu-item">
                <i class="fas fa-user"></i>
                <span>Profile</span>
            </a>
            <a href="#" class="menu-item logout" onclick="logout()">
                <i class="fas fa-sign-out-alt"></i>
                <span>Logout</span>
            </a>
        </nav>
    </aside>

    <!-- Main Content -->
    <main class="main-content">
        <!-- Header -->
        <header class="dashboard-header">
            <div class="header-left">
                <h1>My Courses</h1>
                <p>Courses based on your branch and year</p>
            </div>
            <div class="header-right">
                <input type="text" class="search-input" placeholder="Search courses..." id="courseSearch">
            </div>
        </header>

        <!-- Dashboard Content -->
        <div class="dashboard-content">
            <!-- Filters -->
            <div class="filter-section">
                <button class="filter-btn active" onclick="filterCourses('all')">All</button>
                <button class="filter-btn" onclick="filterCourses('enrolled')">Enrolled</button>
                <button class="filter-btn" onclick="filterCourses('available')">Available</button>
            </div>

            <!-- Courses Grid -->
            <div class="courses-grid" id="coursesContainer">
                <div class="loading">Loading courses...</div>
            </div>
        </div>
    </main>

    <script src="/js/dashboard.js"></script>
</body>
</html>
