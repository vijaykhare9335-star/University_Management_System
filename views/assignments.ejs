<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Assignment Management - University ERP</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>
<body class="dashboard-page">
    <!-- Sidebar -->
    <aside class="sidebar">
        <div class="sidebar-header">
            <i class="fas fa-chalkboard-teacher"></i>
            <span>Instructor Portal</span>
        </div>

        <nav class="sidebar-menu">
            <a href="/instructor-dashboard" class="menu-item">
                <i class="fas fa-home"></i>
                <span>Dashboard</span>
            </a>
            <a href="/my-classes" class="menu-item">
                <i class="fas fa-book"></i>
                <span>My Classes</span>
            </a>
            <a href="/students-list" class="menu-item">
                <i class="fas fa-users"></i>
                <span>Students</span>
            </a>
            <a href="/upload-grades" class="menu-item">
                <i class="fas fa-chart-bar"></i>
                <span>Upload Grades</span>
            </a>
            <a href="/attendance" class="menu-item">
                <i class="fas fa-calendar-check"></i>
                <span>Attendance</span>
            </a>
            <a href="/assignments" class="menu-item active">
                <i class="fas fa-tasks"></i>
                <span>Assignments</span>
            </a>
            <a href="/assign-course" class="menu-item">
                <i class="fas fa-plus-circle"></i>
                <span>Assign Course</span>
            </a>
            <a href="/announcements" class="menu-item">
                <i class="fas fa-bell"></i>
                <span>Announcements</span>
            </a>
            <a href="/profile" class="menu-item">
                <i class="fas fa-user"></i>
                <span>Profile</span>
            </a>
            <a href="#" class="menu-item logout" onclick="logout()">
                <i class="fas fa-sign-out-alt"></i>
                <span>Logout</span>
            </a>
        </nav>
    </aside>

    <!-- Main Content -->
    <main class="main-content">
        <!-- Header -->
        <header class="dashboard-header">
            <div class="header-left">
                <h1>Assignment Management</h1>
                <p>Create and manage course assignments</p>
            </div>
            <div class="header-right">
                <button onclick="showCreateAssignmentModal()" class="btn-primary">
                    <i class="fas fa-plus"></i> Create Assignment
                </button>
            </div>
        </header>

        <!-- Dashboard Content -->
        <div class="dashboard-content">
            <!-- Course Selection -->
            <div class="form-section">
                <h3>Select Course</h3>
                <select id="courseSelect" onchange="loadAssignments()">
                    <option value="">Choose a course...</option>
                </select>
            </div>

            <!-- Assignments List -->
            <div id="assignmentsSection" style="display: none;">
                <div class="assignments-grid" id="assignmentsContainer">
                    <!-- Assignments will be loaded here -->
                </div>
            </div>
        </div>
    </main>

    <!-- Create Assignment Modal -->
    <div id="createAssignmentModal" class="modal" style="display: none;">
        <div class="modal-content">
            <div class="modal-header">
                <h3>Create New Assignment</h3>
                <span class="close" onclick="closeModal()">&times;</span>
            </div>
            <div class="modal-body">
                <form id="createAssignmentForm">
                    <div class="form-group">
                        <label for="assignmentTitle">Title:</label>
                        <input type="text" id="assignmentTitle" required>
                    </div>
                    <div class="form-group">
                        <label for="assignmentDescription">Description:</label>
                        <textarea id="assignmentDescription" rows="4"></textarea>
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label for="dueDate">Due Date:</label>
                            <input type="date" id="dueDate" required>
                        </div>
                        <div class="form-group">
                            <label for="maxMarks">Max Marks:</label>
                            <input type="number" id="maxMarks" value="100" required>
                        </div>
                    </div>
                    <button type="submit" class="btn-primary">Create Assignment</button>
                </form>
            </div>
        </div>
    </div>

    <script src="/js/instructor-dashboard.js"></script>
    <script>
        // Load courses on page load
        document.addEventListener('DOMContentLoaded', function() {
            loadInstructorCourses();
        });

        // Load assignments for selected course
        async function loadAssignments() {
            const courseSelect = document.getElementById('courseSelect');
            const offeringId = courseSelect.value;

            if (!offeringId) {
                document.getElementById('assignmentsSection').style.display = 'none';
                return;
            }

            try {
                const response = await fetch(`/api/assignments/${offeringId}`, { credentials: 'include' });
                const data = await response.json();

                if (response.ok) {
                    displayAssignments(data.assignments);
                    document.getElementById('assignmentsSection').style.display = 'block';
                } else {
                    alert(data.error || 'Failed to load assignments');
                }
            } catch (err) {
                console.error('Error:', err);
                alert('An error occurred');
            }
        }

        // Display assignments
        function displayAssignments(assignments) {
            const container = document.getElementById('assignmentsContainer');

            if (assignments.length === 0) {
                container.innerHTML = '<p style="text-align: center; color: var(--text-secondary);">No assignments created yet</p>';
                return;
            }

            container.innerHTML = assignments.map(assignment => `
                <div class="assignment-card">
                    <div class="assignment-header">
                        <h4>${assignment.title}</h4>
                        <span class="due-date">Due: ${new Date(assignment.dueDate).toLocaleDateString()}</span>
                    </div>
                    <p class="assignment-description">${assignment.description || 'No description'}</p>
                    <div class="assignment-stats">
                        <span><i class="fas fa-star"></i> ${assignment.maxMarks} marks</span>
                        <span><i class="fas fa-users"></i> ${assignment.submissionsCount} submissions</span>
                    </div>
                    <div class="assignment-actions">
                        <button onclick="viewSubmissions(${assignment.assignmentId})" class="btn-secondary">
                            <i class="fas fa-eye"></i> View Submissions
                        </button>
                        <button onclick="editAssignment(${assignment.assignmentId})" class="btn-secondary">
                            <i class="fas fa-edit"></i> Edit
                        </button>
                    </div>
                </div>
            `).join('');
        }

        // Show create assignment modal
        function showCreateAssignmentModal() {
            const offeringId = document.getElementById('courseSelect').value;
            if (!offeringId) {
                alert('Please select a course first');
                return;
            }

            document.getElementById('createAssignmentModal').style.display = 'block';
        }

        // Close modal
        function closeModal() {
            document.getElementById('createAssignmentModal').style.display = 'none';
            document.getElementById('createAssignmentForm').reset();
        }

        // Handle create assignment form
        document.getElementById('createAssignmentForm').addEventListener('submit', async function(e) {
            e.preventDefault();

            const offeringId = document.getElementById('courseSelect').value;
            const title = document.getElementById('assignmentTitle').value;
            const description = document.getElementById('assignmentDescription').value;
            const dueDate = document.getElementById('dueDate').value;
            const maxMarks = document.getElementById('maxMarks').value;

            try {
                const response = await fetch('/api/create-assignment', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        offeringId,
                        title,
                        description,
                        dueDate,
                        maxMarks
                    }),
                    credentials: 'include'
                });

                const data = await response.json();

                if (response.ok) {
                    alert('Assignment created successfully!');
                    closeModal();
                    loadAssignments();
                } else {
                    alert(data.error || 'Failed to create assignment');
                }
            } catch (err) {
                console.error('Error:', err);
                alert('An error occurred');
            }
        });

        // View submissions
        async function viewSubmissions(assignmentId) {
            // This would open a submissions page or modal
            window.location.href = `/assignment-submissions/${assignmentId}`;
        }

        // Edit assignment (placeholder)
        function editAssignment(assignmentId) {
            alert('Edit functionality coming soon!');
        }
    </script>
</body>
</html>