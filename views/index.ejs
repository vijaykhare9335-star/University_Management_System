<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>University ERP System - Home</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>
<body>
    <!-- Navigation Bar -->
    <nav class="navbar">
        <div class="nav-container">
            <div class="logo">
                <i class="fas fa-graduation-cap"></i>
                <span>University ERP</span>
            </div>
            <div class="nav-buttons">
                <a href="#student-corner" class="nav-btn">Student Corner</a>
                <a href="#technical-hub" class="nav-btn">Technical Hub</a>
                <a href="#announcements" class="nav-btn">Announcements</a>
                <a href="#placements" class="nav-btn">Placements</a>
            </div>
        </div>
    </nav>

    <!-- Hero Section -->
    <section class="hero">
        <div class="hero-content">
            <h1>Welcome to <span class="highlight">University ERP System</span></h1>
            <p>Your Complete Academic Management Platform</p>
            <div class="hero-buttons">
                <a href="/login" class="btn btn-primary">Student Login</a>
                <a href="/login" class="btn btn-secondary">Faculty Login</a>
            </div>
        </div>
    </section>

    <!-- 1. Student Corner Section -->
    <section id="student-corner" class="section student-corner">
        <div class="container">
            <h2><i class="fas fa-book"></i> Student Corner</h2>
            <div class="cards-grid">
                <div class="card">
                    <div class="card-icon">
                        <i class="fas fa-edit"></i>
                    </div>
                    <h3>Enrollment</h3>
                    <p>Browse courses and enroll in classes matching your branch and year of study.</p>
                    <a href="/login" class="card-link">Enroll Now →</a>
                </div>
                <div class="card">
                    <div class="card-icon">
                        <i class="fas fa-chart-bar"></i>
                    </div>
                    <h3>View Grades</h3>
                    <p>Check your semester grades, assignments, and academic performance.</p>
                    <a href="/login" class="card-link">View Grades →</a>
                </div>
                <div class="card">
                    <div class="card-icon">
                        <i class="fas fa-calendar"></i>
                    </div>
                    <h3>Timetable</h3>
                    <p>Access your class schedule and exam timetable for current semester.</p>
                    <a href="/login" class="card-link">View Timetable →</a>
                </div>
                <div class="card">
                    <div class="card-icon">
                        <i class="fas fa-download"></i>
                    </div>
                    <h3>Course Materials</h3>
                    <p>Download lecture notes, study materials, and assignments from faculty.</p>
                    <a href="/login" class="card-link">Download →</a>
                </div>
            </div>
        </div>
    </section>

    <!-- 2. Technical Hub Section -->
    <section id="technical-hub" class="section technical-hub">
        <div class="container">
            <h2><i class="fas fa-code"></i> Technical Hub</h2>
            <div class="cards-grid">
                <div class="card dark-card">
                    <h3>Programming Labs</h3>
                    <p>Access online programming environments for C, C++, Java, and Python practice.</p>
                    <div class="tech-tags">
                        <span class="tag">#C++</span>
                        <span class="tag">#Java</span>
                        <span class="tag">#Python</span>
                    </div>
                </div>
                <div class="card dark-card">
                    <h3>Database Lab</h3>
                    <p>Hands-on experience with MySQL, Oracle, and SQL Server databases.</p>
                    <div class="tech-tags">
                        <span class="tag">#Database</span>
                        <span class="tag">#SQL</span>
                        <span class="tag">#Oracle</span>
                    </div>
                </div>
                <div class="card dark-card">
                    <h3>Web Development</h3>
                    <p>Learn HTML, CSS, JavaScript, React, Node.js, and full-stack development.</p>
                    <div class="tech-tags">
                        <span class="tag">#Web</span>
                        <span class="tag">#React</span>
                        <span class="tag">#Node.js</span>
                    </div>
                </div>
                <div class="card dark-card">
                    <h3>AI & Machine Learning</h3>
                    <p>Explore machine learning algorithms, TensorFlow, and AI applications.</p>
                    <div class="tech-tags">
                        <span class="tag">#AI</span>
                        <span class="tag">#ML</span>
                        <span class="tag">#Python</span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- 3. Notices & Announcements Section -->
    <section id="announcements" class="section announcements">
        <div class="container">
            <h2><i class="fas fa-bell"></i> Notices & Announcements</h2>
            <div class="announcements-list">
                <div class="announcement-item">
                    <div class="announcement-date">Today</div>
                    <div class="announcement-content">
                        <h4>Final Semester Exam Schedule Released</h4>
                        <p>The final examination schedule for Spring 2024 has been released. Check your exam dates and venues on the portal.</p>
                    </div>
                </div>
                <div class="announcement-item">
                    <div class="announcement-date">2 Days Ago</div>
                    <div class="announcement-content">
                        <h4>Internship Registration Opens</h4>
                        <p>Applications for summer internship program are now open for 2nd and 3rd year students. Register before April 15.</p>
                    </div>
                </div>
                <div class="announcement-item">
                    <div class="announcement-date">5 Days Ago</div>
                    <div class="announcement-content">
                        <h4>Library Renovation Complete</h4>
                        <p>Our newly renovated library with advanced facilities is now open. Extended hours: 8 AM - 10 PM.</p>
                    </div>
                </div>
                <div class="announcement-item">
                    <div class="announcement-date">1 Week Ago</div>
                    <div class="announcement-content">
                        <h4>Placement Drive Dates Announced</h4>
                        <p>Top companies will be visiting campus. Visit the Placement section for company details and eligibility criteria.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- 4. Upcoming Events Section -->
    <section class="section upcoming-events">
        <div class="container">
            <h2><i class="fas fa-calendar-check"></i> Upcoming Events</h2>
            <div class="timeline">
                <div class="timeline-item">
                    <div class="timeline-marker">April 10</div>
                    <div class="timeline-content">
                        <h4>Coding Competition 2024</h4>
                        <p>Online coding contest with prizes. Best for competitive programming enthusiasts.</p>
                    </div>
                </div>
                <div class="timeline-item">
                    <div class="timeline-marker">April 15</div>
                    <div class="timeline-content">
                        <h4>Internship Fair</h4>
                        <p>Meet with recruiting companies and explore internship opportunities.</p>
                    </div>
                </div>
                <div class="timeline-item">
                    <div class="timeline-marker">April 20</div>
                    <div class="timeline-content">
                        <h4>Guest Lecture - Industry Expert</h4>
                        <p>Lecture on latest trends in Cloud Computing and DevOps.</p>
                    </div>
                </div>
                <div class="timeline-item">
                    <div class="timeline-marker">April 25</div>
                    <div class="timeline-content">
                        <h4>Annual Tech Fest</h4>
                        <p>College's biggest event with workshops, competitions, and networking.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- 5. Faculty Highlights Section -->
    <section class="section faculty-highlights">
        <div class="container">
            <h2><i class="fas fa-chalkboard-user"></i> Faculty Highlights</h2>
            <div class="faculty-highlights-grid">
                <div class="faculty-card">
                    <div class="faculty-avatar"><i class="fas fa-user"></i></div>
                    <h4>Dr. Rajesh Kumar</h4>
                    <p class="faculty-title">HOD - Computer Science</p>
                    <p class="faculty-bio">PhD in Computer Science, 15+ years of experience in teaching and research.</p>
                    <p class="faculty-email">📧 rajesh@university.edu</p>
                </div>
                <div class="faculty-card">
                    <div class="faculty-avatar"><i class="fas fa-user"></i></div>
                    <h4>Dr. Priya Sharma</h4>
                    <p class="faculty-title">Professor - Information Technology</p>
                    <p class="faculty-bio">Specialization in AI and ML, Published 30+ research papers.</p>
                    <p class="faculty-email">📧 priya@university.edu</p>
                </div>
                <div class="faculty-card">
                    <div class="faculty-avatar"><i class="fas fa-user"></i></div>
                    <h4>Dr. Amit Patel</h4>
                    <p class="faculty-title">Associate Professor - Mechanical</p>
                    <p class="faculty-bio">Expert in CAD/CAM and Robotics, Industry consultant.</p>
                    <p class="faculty-email">📧 amit@university.edu</p>
                </div>
            </div>
        </div>
    </section>

    <!-- 6. Placement Updates Section -->
    <section id="placements" class="section placements">
        <div class="container">
            <h2><i class="fas fa-briefcase"></i> Placement Updates</h2>
            <div class="stats-grid">
                <div class="stat-card">
                    <h3>95%</h3>
                    <p>Placement Rate</p>
                    <span class="stat-description">Students successfully placed</span>
                </div>
                <div class="stat-card">
                    <h3>₹8 LPA</h3>
                    <p>Avg. Package</p>
                    <span class="stat-description">Average salary offered</span>
                </div>
                <div class="stat-card">
                    <h3>₹18 LPA</h3>
                    <p>Highest Package</p>
                    <span class="stat-description">Maximum salary offered</span>
                </div>
                <div class="stat-card">
                    <h3>50+</h3>
                    <p>Companies</p>
                    <span class="stat-description">Recruiting from campus</span>
                </div>
            </div>
            <div class="placement-updates">
                <h3>Recent Placements</h3>
                <div class="company-list">
                    <div class="company-item">
                        <span class="company-name">Google India</span>
                        <span class="company-role">Software Engineer (₹15 LPA)</span>
                    </div>
                    <div class="company-item">
                        <span class="company-name">Microsoft</span>
                        <span class="company-role">Data Scientist (₹12 LPA)</span>
                    </div>
                    <div class="company-item">
                        <span class="company-name">Amazon</span>
                        <span class="company-role">Software Development Engineer (₹14 LPA)</span>
                    </div>
                    <div class="company-item">
                        <span class="company-name">TCS</span>
                        <span class="company-role">Associate Engineer (₹6 LPA)</span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- 7. Internship Opportunities Section -->
    <section class="section internships">
        <div class="container">
            <h2><i class="fas fa-rocket"></i> Internship Opportunities</h2>
            <div class="internship-cards">
                <div class="internship-card">
                    <div class="tag internship-tag">Featured</div>
                    <h4>Data Science Internship</h4>
                    <p class="company">Google India</p>
                    <p class="duration">Duration: 3 months | Stipend: ₹30,000/month</p>
                    <p class="description">Work on real-world machine learning projects with mentorship from experts.</p>
                    <button class="btn-apply">Apply Now</button>
                </div>
                <div class="internship-card">
                    <div class="tag internship-tag">Featured</div>
                    <h4>Full Stack Web Development</h4>
                    <p class="company">Startup Incubator</p>
                    <p class="duration">Duration: 2 months | Stipend: ₹20,000/month</p>
                    <p class="description">Build and deploy web applications using React and Node.js.</p>
                    <button class="btn-apply">Apply Now</button>
                </div>
                <div class="internship-card">
                    <h4>Cloud Infrastructure</h4>
                    <p class="company">AWS Academy</p>
                    <p class="duration">Duration: 3 months | Stipend: ₹25,000/month</p>
                    <p class="description">Learn cloud deployment, DevOps, and infrastructure management.</p>
                    <button class="btn-apply">Apply Now</button>
                </div>
            </div>
        </div>
    </section>

    <!-- 8. Academic Calendar Section -->
    <section class="section academic-calendar">
        <div class="container">
            <h2><i class="fas fa-calendar"></i> Academic Calendar</h2>
            <div class="calendar-grid">
                <div class="calendar-item">
                    <h4>Spring Semester</h4>
                    <ul>
                        <li>Start: January 15, 2024</li>
                        <li>Mid Term: February 28, 2024</li>
                        <li>End: April 30, 2024</li>
                    </ul>
                </div>
                <div class="calendar-item">
                    <h4>Summer Break</h4>
                    <ul>
                        <li>Duration: May 1 - July 14, 2024</li>
                        <li>Summer Internships</li>
                        <li>Advanced Courses</li>
                    </ul>
                </div>
                <div class="calendar-item">
                    <h4>Fall Semester</h4>
                    <ul>
                        <li>Start: July 15, 2024</li>
                        <li>Mid Term: September 15, 2024</li>
                        <li>End: November 25, 2024</li>
                    </ul>
                </div>
                <div class="calendar-item">
                    <h4>Year-End Break</h4>
                    <ul>
                        <li>Start: December 1, 2024</li>
                        <li>Duration: 1 month</li>
                        <li>Next Semester: January 2025</li>
                    </ul>
                </div>
            </div>
        </div>
    </section>

    <!-- 9. Achievements Section -->
    <section class="section achievements">
        <div class="container">
            <h2><i class="fas fa-trophy"></i> Achievements</h2>
            <div class="achievements-grid">
                <div class="achievement-card">
                    <i class="fas fa-award"></i>
                    <h4>Ranked #1</h4>
                    <p>in Engineering Colleges - National Survey 2024</p>
                </div>
                <div class="achievement-card">
                    <i class="fas fa-medal"></i>
                    <h4>ISO 9001:2015</h4>
                    <p>Quality Management System Certified</p>
                </div>
                <div class="achievement-card">
                    <i class="fas fa-star"></i>
                    <h4>NAAC A+</h4>
                    <p>National Accreditation and Assessment Council</p>
                </div>
                <div class="achievement-card">
                    <i class="fas fa-certificate"></i>
                    <h4>100+ Patents</h4>
                    <p>Filed by Faculty and Students</p>
                </div>
            </div>
        </div>
    </section>

    <!-- 10. Help & Support Section -->
    <section id="contact" class="section help-support">
        <div class="container">
            <h2><i class="fas fa-headset"></i> Help & Support</h2>
            <div class="support-grid">
                <div class="support-card">
                    <i class="fas fa-phone"></i>
                    <h4>Phone Support</h4>
                    <p>+91-0123-456-7890</p>
                    <p class="timing">Mon - Fri: 9 AM - 5 PM</p>
                </div>
                <div class="support-card">
                    <i class="fas fa-envelope"></i>
                    <h4>Email Support</h4>
                    <p>support@university.edu</p>
                    <p class="timing">Response within 24 hours</p>
                </div>
                <div class="support-card">
                    <i class="fas fa-comments"></i>
                    <h4>Live Chat</h4>
                    <p>Available on Portal</p>
                    <p class="timing">Available during office hours</p>
                </div>
                <div class="support-card">
                    <i class="fas fa-location-dot"></i>
                    <h4>Visit Us</h4>
                    <p>Student Support Center</p>
                    <p class="timing">Main Campus, Block A</p>
                </div>
            </div>
            <div class="faq-section">
                <h3>Frequently Asked Questions</h3>
                <div class="faq-item">
                    <h4>How do I enroll in courses?</h4>
                    <p>Log in to your account, go to "My Courses" and click the "Enroll" button for desired courses.</p>
                </div>
                <div class="faq-item">
                    <h4>When can I check my grades?</h4>
                    <p>Grades are typically available 7 days after the exam. Check the "Grades" section in your dashboard.</p>
                </div>
                <div class="faq-item">
                    <h4>How do I download course materials?</h4>
                    <p>Navigate to the course page and click "Download Materials" to access all faculty-provided resources.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer class="footer">
        <div class="container">
            <div class="footer-content">
                <div class="footer-section">
                    <h4>About University</h4>
                    <p>Leading engineering institution dedicated to academic excellence and student success.</p>
                </div>
                <div class="footer-section">
                    <h4>Quick Links</h4>
                    <ul>
                        <li><a href="#student-corner">Student Corner</a></li>
                        <li><a href="#announcements">Announcements</a></li>
                        <li><a href="#placements">Placements</a></li>
                        <li><a href="/faculty">Faculty</a></li>
                    </ul>
                </div>
                <div class="footer-section">
                    <h4>Follow Us</h4>
                    <div class="social-links">
                        <a href="#"><i class="fab fa-facebook"></i></a>
                        <a href="#"><i class="fab fa-twitter"></i></a>
                        <a href="#"><i class="fab fa-linkedin"></i></a>
                        <a href="#"><i class="fab fa-instagram"></i></a>
                    </div>
                </div>
            </div>
            <div class="footer-bottom">
                <p>&copy; 2024 University ERP System. All rights reserved.</p>
            </div>
        </div>
    </footer>

    <script src="/js/main.js"></script>
</body>
</html>
